/* variáveis */
:root {
  --fundo: #181b1f;
  --card: #20242a;
  --preto: #0e1013;
  --borda: #343a41;
  --ceu: #47455a;
  --branco: #eeeeea;
  --cinza: #a0a8b0;
  --amarelo: #e0a03c;
  --azul: #4aa8e8;
  --verde: #78cf5a;
  --vermelho: #ee6a5d;
  --fonte: Helvetica, Arial, sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body { background: var(--fundo); color: var(--branco); font-family: var(--fonte); font-size: 17px; line-height: 1.7; }
a { color: var(--amarelo); text-decoration: none; }
h1, h2, h3, h4 { line-height: 1.2; }
h4 { font-size: 18px; }

/* cada seção muda o valor da variável --cor */
#sobre, #formacao { --cor: var(--amarelo); }
#habilidades, #contato { --cor: var(--azul); }
#projetos { --cor: var(--verde); }
#experiencia { --cor: var(--vermelho); }

h3 { font-size: 26px; margin-bottom: 28px; padding: 0 0 12px 14px; border-left: 12px solid var(--cor); border-bottom: 2px solid var(--cor); }

/* menu: position fixed + flexbox */
header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 24px;
  padding: 16px 8%;
  background: var(--preto);
  border-bottom: 1px solid var(--borda);
}
.logo { color: var(--branco); font-family: "Arial Black", Arial, sans-serif; font-size: 21px; letter-spacing: 1px; text-transform: uppercase; }
nav { display: flex; flex-wrap: wrap; gap: 6px 24px; }
nav a { color: var(--cinza); font-size: 15px; }

/* hero: flexbox + position absolute no skyline */
.hero {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 40px;
  padding: 140px 8% 240px;
  background: var(--ceu);
}
.hero div { position: relative; z-index: 2; flex: 1 1 320px; }
.hero img { position: relative; z-index: 2; width: 250px; border: 5px solid var(--branco); }
.hero svg { position: absolute; left: 0; bottom: 0; width: 100%; height: 260px; z-index: 1; }
.hero h1 { font-family: "Arial Black", Arial, sans-serif; font-size: 9vw; line-height: 1; text-transform: uppercase; }
.hero h2 { margin: 16px 0 8px; font-size: 24px; color: var(--amarelo); }
.hero p { max-width: 480px; }
.hero a { display: inline-block; margin: 28px 12px 0 0; padding: 14px 28px; color: var(--branco); font-weight: bold; border: 2px solid var(--branco); }

main { padding: 0 8% 100px; }
/* espaço no topo pro menu fixo não tapar o título */
main section { padding-top: 90px; }

#sobre p { max-width: 640px; font-size: 20px; }

/* tabela */
table { width: 100%; border-collapse: collapse; background: var(--card); }
th, td { padding: 16px 20px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--borda); }
th { color: var(--cinza); font-weight: normal; background: var(--preto); border-bottom: 2px solid var(--cor); }

/* caixas dos projetos, da formação e do formulário */
#projetos article, #formacao li, form {
  padding: 24px;
  background: var(--card);
  border: 1px solid var(--borda);
  border-top: 4px solid var(--cor);
}

/* projetos: flexbox */
#projetos { display: flex; flex-wrap: wrap; gap: 24px; }
#projetos h3 { width: 100%; margin-bottom: 0; }
#projetos article { flex: 1 1 280px; display: flex; flex-direction: column; gap: 12px; }
#projetos p { color: var(--cinza); }
#projetos ul { display: flex; flex-wrap: wrap; gap: 4px 14px; list-style: none; color: var(--cor); font-size: 14px; }
#projetos a { color: var(--cor); font-weight: bold; }

/* experiência */
#experiencia article { margin-bottom: 32px; padding-left: 24px; border-left: 4px solid var(--cor); }
#experiencia ul { margin-left: 20px; color: var(--cinza); }
time { display: block; color: var(--cor); font-size: 14px; font-weight: bold; }

/* formação: grid com 3 colunas */
#formacao ul { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; list-style: none; }
#formacao strong { display: block; }
#formacao span { color: var(--cinza); }

/* formulário: flexbox */
form { display: flex; flex-wrap: wrap; gap: 20px; }
label { flex: 1 1 260px; display: flex; flex-direction: column; gap: 8px; font-weight: bold; }
input, textarea { padding: 12px 14px; font-family: var(--fonte); font-size: 16px; color: var(--branco); background: var(--fundo); border: 1px solid var(--borda); }
textarea { min-height: 140px; }
form div { flex: 1 1 100%; display: flex; justify-content: flex-end; gap: 14px; }
button { padding: 14px 28px; font-family: var(--fonte); font-size: 16px; font-weight: bold; color: #000; background: var(--amarelo); border: 0; cursor: pointer; }

/* rodapé: flexbox */
footer { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px 24px; padding: 40px 8%; color: var(--cinza); background: var(--preto); border-top: 1px solid var(--borda); }
footer a { font-weight: bold; }
